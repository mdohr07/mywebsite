---
import Layout from "../../layouts/Layout.astro";

const formatDate = (pubDate: any) => {
  return new Date(pubDate).toLocaleDateString("de-DE", {
    day: "numeric",    // 1
    month: "long",     // Juli
    year: "numeric",   // 2022
  });
};

export async function getStaticPaths() {
  const allPosts = Object.values(
    import.meta.glob("../posts/*.md", { eager: true })
  );

  // Alle eindeutigen Tags sammeln
  const uniqueTags = [
    ...new Set(allPosts.map((post: any) => post.data.tags).flat()),
  ];

  // Für jeden Tag eine Route erstellen
  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts
    .filter((post: any) => post.data.tags.includes(tag))
    .sort((a:any, b: any) => {
       return new Date(b.frontmatter.pubDate).getTime() - new Date(a.data.pubDate).getTime();
    });

    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Layout pageTitle={tag} lang="de">
  <h1>Posts tagged with "{tag}"</h1>
<ul class="post-list">
  {posts.map((post: any) => (
    <li class="post-item">
      <div class="post-header">
        <a href={post.url} class="post-title">{post.data.title}</a>
        <span class="post-date">{formatDate(post.data.pubDate)}</span>
      </div>
      <p class="post-description">{post.data.description}</p>
    </li>
  ))}
</ul>
</Layout>