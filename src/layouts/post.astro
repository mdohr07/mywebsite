---
import Layout from './Layout.astro';
const { content } = Astro.props;
const { title, pubDate } = content;
---

<Layout title={title}>
  <article>
    <p class="post-date">{new Date(pubDate).toLocaleDateString('de-DE')}</p>
    <!-- 
    Music
    Mood
    Tags -->
    <hr>
    <slot />
  </article>
</Layout>
