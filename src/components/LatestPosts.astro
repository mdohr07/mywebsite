//     day: "numeric", // 1
//     month: "long", // July
//     year: "numeric", // 2022
//   });
// };
---

<section class="latest-posts">
  <h2>Latest Blog Posts</h2>
  <ul class="latest-post-list">
    {
      posts && posts.length > 0 ? (
        posts.map((post) => (
          <li>
            <a href={`/posts/${post.slug}`}>{post.data.title ?? "Ohne Titel"}</a>
          </li>
        ))
      ) : (
        <p>No entries found 💀</p>
      )
    }
  </ul>
</section>
