---

const { content } = Astro.props;

const { title, pubDate, author, mood, music, tags, image } = content;

const formatDate = (pubDate: Date) => {
  return pubDate.toLocaleDateString("de-DE", {
    weekday: "long", // Friday
    year: "numeric", // 2022
    month: "long", // July
    day: "numeric", // 1
  });
};
---

<div>
  <h1>{title}</h1>
  <article lang="de">
    <p class="author">
      <span class="secondary-text">Verfasst von</span><span class="authorName">{author || "Unbekannt"}</span>
      <span class="secondary-text">am</span>
      {formatDate(pubDate)}
    </p>

    <slot />

    <!-- <img src={image.url} alt=""> -->

    <section class="meta">
      <section class="general">
        <p>Stimmung: {mood}</p>
        <p>
          Musik: {
            music?.url ? (
              <a href={music.url} target="_blank" rel="noopener noreferrer">
                {music?.artist || "Unbekannt"} - {music?.title || "Unbekannt"}
              </a>
            ) : (
              music?.title || "Keine Musik"
            )
          }
        </p>
      </section>

      <section class="meta-tags">
        Tags:
        {
          tags &&
            tags.map((tag: any) => (
              <p class="meta-tag">
                <a href={`/tags/${tag}`}>{tag}</a>
              </p>
            ))
        }
      </section>
    </section>
  </article>
</div>
