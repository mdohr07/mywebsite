---
const { content } = Astro.props;
const { title, 
        pubDate, 
        author, 
        mood,
        musicTitle,
        musicUrl
        } = content;
---

<div title={title}>
  <article>
   
    <!-- Tags -->
    <slot />

    <p class="author">Written by { author }</p>
  </article>
  ---<br>
  <section>
    <p>Mood: { mood }</p>
    <p>Music: <a href={musicUrl} target="_blank" rel="noopener noreferrer">{ musicTitle }</a></p>
  </section>
</div>
