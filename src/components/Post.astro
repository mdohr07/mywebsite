---
import Layout from "../layouts/Layout.astro";
const { content } = Astro.props;

const { title, pubDate, author, mood, musicTitle, musicUrl, tags } = content;

const formatDate = (pubDate: any) => {
  return new Date(pubDate).toLocaleDateString("de-DE", {
    weekday: "long", // Friday
    year: "numeric", // 2022
    month: "long", // July
    day: "numeric", // 1
  });
};

const date = formatDate(pubDate);
---

<Layout>
  <div title={title}>
    <article>
      <slot />

      <p class="author">
        <span class="secondary-text">Verfasst von </span>{author}
        <span class="secondary-text">am</span>
        {date}
      </p>

      <section class="meta">
        <section class="general">
          <p>Stimmung: {mood}</p>
          <p>
            Musik: <a href={musicUrl} target="_blank" rel="noopener noreferrer">{musicTitle}</a>
          </p>
        </section>

        <section class="meta-tags">
          Tags:
          {
            tags &&
              tags.map((tag: any) => (
                <p class="meta-tag">
                  <a href={`/post/tags/${tag}`}>{tag}</a>
                </p>
              ))
          }
        </section>
      </section>
    </article>
  </div>
</Layout>
