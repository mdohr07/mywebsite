---
import Layout from "../layouts/Layout.astro";

const { content } = Astro.props;
const { title, pubDate, author, mood, musicTitle, musicUrl } = content;

const formatDate = (pubDate: any) => {
  return new Date(pubDate).toLocaleDateString("de-DE", {
    weekday: "long", // Friday
    year: "numeric", // 2022
    month: "long", // July
    day: "numeric", // 1
  });
};

const date = formatDate(pubDate);
---

<Layout>
  <div title={title}>
    <article>
      <!-- Tags -->
      <slot />

      <section class="meta">
        <p class="author">
          <span class="secondary">Verfasst von </span>{author}
          <span class="secondary">am</span>
          {date}
        </p>
      </section>
      ---<br />
      <p>Stimmung: {mood}</p>
      <p>
        Musik: <a href={musicUrl} target="_blank" rel="noopener noreferrer">{musicTitle}</a>
      </p>
    </article>
  </div>
</Layout>
